FIGA_SERVICE_NAME=fin-insight-graph-agent
FIGA_ENVIRONMENT=local
FIGA_LOG_LEVEL=INFO
FIGA_SEC_API_BASE_URL=https://data.sec.gov
FIGA_SEC_API_USER_AGENT=FinInsightGraphAgent/1.0 (research@example.com)
FIGA_ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
FIGA_ALPHA_VANTAGE_API_KEY=demo
FIGA_EVALUATION_DATASET_ROOT=D:/myAgent/.worktrees/fin-insight-v1/tests/fixtures/evaluation
FIGA_GRAPH_BENCHMARK_SUITE=graph_retrieval_smoke
FIGA_MODEL_API_BASE_URL=https://api.openai.com/v1
FIGA_MODEL_API_KEY=
FIGA_EMBEDDING_PROVIDER=simple
FIGA_EMBEDDING_MODEL=text-embedding-3-small
FIGA_EMBEDDING_DIMENSIONS=16
FIGA_LLM_PROVIDER=heuristic
FIGA_LLM_MODEL=gpt-4.1-mini
FIGA_LLM_TEMPERATURE=0.1
FIGA_RERANKER_PROVIDER=heuristic
FIGA_RERANKER_API_URL=http://127.0.0.1:8001/rerank
FIGA_RERANKER_API_KEY=
FIGA_RERANKER_MODEL=bge-reranker-v2-m3
FIGA_PROMPT_VERSION=prompt:v1
FIGA_QDRANT_COLLECTION_NAME=chunks

